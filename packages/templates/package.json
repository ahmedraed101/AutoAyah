{
  "name": "@autoayah/templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frames": {
      "types": "./dist/remotion/frames.d.ts",
      "import": "./dist/remotion/frames.js"
    },
    "./remotion": {
      "types": "./dist/remotion/index.d.ts",
      "import": "./dist/remotion/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@autoayah/core": "workspace:*",
    "@remotion/google-fonts": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "react": "^19.1.0",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "remotion": "^4.0.0"
  }
}
