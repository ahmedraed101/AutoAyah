APP_MODE=self_hosted
# APP_PASSWORD=
# Encrypts stored API keys and signs login sessions. Leave unset to have one generated
# and kept in $DATA_DIR/.secret; set it explicitly when running several instances.
# APP_SECRET=
PORT=3737
PUBLIC_URL=http://localhost:3737
DATA_DIR=./data
MAX_CONCURRENT_RENDERS=1
# RENDER_LIMIT_PER_DAY=
# MAX_VIDEO_SECONDS=
# MAX_AYAT_PER_VIDEO=
# VIDEO_RETENTION_HOURS=
# CACHE_MAX_GB=
# QF_CLIENT_ID=
# QF_CLIENT_SECRET=
QF_ENV=prelive
STORAGE=local
