{
  "name": "autoayah",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @autoayah/server --filter @autoayah/web dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @autoayah/web build && pnpm --filter @autoayah/server build",
    "start": "pnpm --filter @autoayah/server start",
    "test": "pnpm --filter @autoayah/core test && pnpm --filter @autoayah/data test && pnpm --filter @autoayah/templates test",
    "doctor": "pnpm --filter @autoayah/cli start doctor",
    "db:generate": "pnpm --filter @autoayah/server db:generate",
    "db:migrate": "pnpm --filter @autoayah/server db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "core-js"
    ]
  }
}
